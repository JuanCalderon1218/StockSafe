# Copy this file to .env and edit the values. Never commit real secrets.
STOCKSAFE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=stocksafe_db
MONGODB_VAULT_DB=stocksafe_vault
SESSION_SECRET=CHANGE_THIS_WITH_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
BACKUP_PASSPHRASE=CHANGE_THIS_WITH_A_LONG_UNIQUE_BACKUP_KEY_32_PLUS_CHARACTERS
ADMIN_EMAIL=admin@stocksafe.local
ADMIN_PASSWORD=CHANGE_THIS_WITH_A_LONG_ADMIN_PASSWORD
SEED_DEMO_DATA=false
